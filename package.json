{
  "name": "clickfix-first-aid",
  "version": "0.3.3",
  "description": "Stops ClickFix 'verify you are human' attacks, checks if your PC already ran one, and tells you exactly what to do next.",
  "private": true,
  "license": "MIT",
  "author": "Vinay Kumar Mandadi",
  "homepage": "https://vinaykumarchowdary18.github.io/clickfix-first-aid/",
  "repository": "https://github.com/vinaykumarchowdary18/clickfix-first-aid",
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check-build": "node scripts/build.mjs --check",
    "test": "node --test tests/detector.test.mjs tests/contracts.test.mjs",
    "test:e2e": "node --test tests/e2e.test.mjs",
    "test:ps": "pwsh -NoLogo -NoProfile -File checker/tests/Run-Tests.ps1",
    "package": "node scripts/build.mjs --package",
    "links": "node scripts/check-links.mjs",
    "audit:deps": "npm audit --audit-level=moderate"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "1.56.0"
  },
  "bugs": {
    "url": "https://github.com/vinaykumarchowdary18/clickfix-first-aid/issues"
  }
}
